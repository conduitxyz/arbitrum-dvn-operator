# ── Operator identity ─────────────────────────────────────────────────────────
# Your operator wallet (MetaMask) address. The node's keys bind to this address
# and it holds the stake. This wallet is NEVER imported into the node.
OPERATOR_ADDRESS=0xYourWalletAddress

# ── Network parameters (published by the DVN operator) ────────────────────────
# The single on-chain AddressRegistry for this DVN. The onboard command resolves
# every other contract address from it.
ADDRESS_REGISTRY=0xAddressRegistry

# Parent-chain (L1) execution RPC. Used by the node (contract reads: epoch
# schedule, committed-header epoch, batch anchor), the relay sidecar, and the
# Nitro follower.
#
# You do NOT supply an L2 RPC. This bundle runs its own Nitro follower and the
# node reads L2 only from that — which is the point: your attestation reflects
# a block YOUR node re-executed, not one someone else reported.
L1_RPC=https://your-l1-rpc

# Parent-chain beacon (consensus-layer) endpoint. Required when the parent chain
# supports EIP-4844 blobs (Ethereum/Sepolia — the default): the co-located Nitro
# follower reads blob batches through it. It's a parent-chain dependency exactly
# like L1_RPC — your provider's beacon/CL API. Some serve it at the same host
# under /beacon; others give a separate URL.
#
# Leave EMPTY and set PARENT_CHAIN_HAS_BLOBS=false below if this chain's parent
# has no beacon layer (e.g. HyperEVM). The DVN tells you which applies.
L1_BEACON_URL=https://your-l1-beacon

# Does the parent chain support EIP-4844 blobs? true (default) for Ethereum/Sepolia.
# Set false for a parent with no beacon layer (e.g. HyperEVM): the follower then
# runs with --node.dangerous.disable-blob-reader and L1_BEACON_URL is not needed.
# Wrong value is loud, not silent — the follower fatals at boot with
# "a beacon chain RPC URL is required to read batches".
PARENT_CHAIN_HAS_BLOBS=true

# libp2p bootnode multiaddr used to join the relay network (published by the DVN).
BOOTNODE=/dns4/relay.example.com/tcp/8880/p2p/16Uiu2HAmExampleBootnodePeerId

# Conduit's proxy batch-pull gRPC endpoint (published by the DVN), e.g.
# dvnpull-<chain-namespace>.t.conduit-stg.xyz:443. It's a gRPC/TLS endpoint
# (Cloudflare terminates TLS); the node auto-detects TLS from the :443 port (or a
# grpcs:// prefix). When set, the node dials out and co-signs pulled batches,
# authenticating with its header BLS key. Leave empty to run as an attestation-only
# node. (Override auto-detection with PROXY_PULL_TLS=true|false if ever needed.)
PROXY_PULL_URL=

# ── Images ────────────────────────────────────────────────────────────────────
# The published VN node image (contains the vn-node binary + onboard command).
# Override VN_NODE_IMAGE if the DVN publishes to a different registry.
VN_NODE_IMAGE=ghcr.io/conduitxyz/arbitrum-dvn
# IMPORTANT: pin to the specific release the DVN tells you to use — do NOT leave
# this as "latest" in production, as the payload format must match the deployed
# contracts.
VN_NODE_TAG=latest

# The Symbiotic relay sidecar image. Keep this in lockstep with the version the
# DVN was built against.
RELAY_IMAGE=symbioticfi/relay
RELAY_TAG=1.2.0

# ── Relay sidecar epoch retention (fast start) ────────────────────────────────
# How many recent epochs the sidecar keeps. On a FRESH data dir it starts at
# currentEpoch-N+1 instead of replaying every epoch from genesis, so joining a
# long-running network takes minutes instead of hours; the pruner then keeps a
# rolling N-epoch window so the database stops growing forever.
#
# Leave this at the default unless the DVN tells you otherwise — it must stay
# comfortably above the node's attestation epoch window or signatures will be
# requested for epochs the sidecar has already pruned.
#
# Changing it later only affects pruning; to get the fast start on a sidecar
# that already synced from genesis you must wipe its volume:
#   docker compose down -v
# Set to 0 to keep full history (archive node, syncs from genesis).
RELAY_RETENTION_EPOCHS=144
RELAY_PRUNER_ENABLED=true

# ── STF verification (co-located Nitro follower — always on) ──────────────────
# The bundle always runs a Nitro follower that independently re-executes ArbOS;
# the node reads L2 from it and signs its post-state root into every attestation.
# All FOLLOWER_* values below are published by the DVN and are required.
#
# Nitro follower image — the public offchainlabs Nitro node. Pin to the version
# matching this chain's Nitro release (the DVN tells you which; must support the
# chain's ArbOS version). Multi-arch tag resolves per-platform.
NITRO_FOLLOWER_IMAGE=offchainlabs/nitro-node:v3.11.3-beb2108
# Sequencer/relay feed the follower tails (published by the DVN), ws://...:9642
FOLLOWER_FEED_URL=
# URL to this chain's chainInfo.json (published by the DVN).
FOLLOWER_CHAIN_INFO_URL=
# Data-availability mode: calldata | blob | anytrust (published by the DVN).
FOLLOWER_DA_MODE=calldata
# AnyTrust REST aggregator URL (required when FOLLOWER_DA_MODE=anytrust).
FOLLOWER_DAS_URL=
# AnyTrust online-url-list endpoint (optional; committee discovery, e.g. :9876).
FOLLOWER_DAS_ONLINE_URL=
# Beacon endpoint for the follower. Defaults from L1_BEACON_URL above; only set
# this to override it independently. Required (via L1_BEACON_URL) unless
# PARENT_CHAIN_HAS_BLOBS=false.
FOLLOWER_BEACON_URL=
